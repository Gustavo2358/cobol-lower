{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Forma documental de work-item.yaml do cobol-lower",
  "type": "object",
  "required": [
    "schema_version",
    "id",
    "title",
    "status",
    "risk",
    "goal",
    "authorization",
    "backlog_ids",
    "must_read",
    "related_domain_rules",
    "related_decisions",
    "related_invariants",
    "evals",
    "source_scope",
    "test_scope",
    "docs_scope",
    "must_not_change",
    "gates",
    "gate_profile",
    "checkpoints",
    "git"
  ],
  "properties": {
    "schema_version": {
      "const": 1
    },
    "id": {
      "type": "string",
      "pattern": "^WORK-[A-Z][A-Z0-9-]*-[0-9]{3}$"
    },
    "title": {
      "type": "string",
      "minLength": 1
    },
    "status": {
      "enum": [
        "proposed",
        "ready_for_authorization",
        "active",
        "blocked",
        "completed"
      ]
    },
    "risk": {
      "enum": [
        "low",
        "medium",
        "high"
      ]
    },
    "goal": {
      "type": "string",
      "minLength": 1
    },
    "authorization": {
      "type": "object",
      "required": [
        "state",
        "scope",
        "current_checkpoint",
        "authorized_checkpoints"
      ],
      "properties": {
        "state": {
          "enum": [
            "not_granted",
            "granted",
            "revoked"
          ]
        },
        "scope": {
          "type": "string",
          "minLength": 1
        },
        "current_checkpoint": {
          "type": [
            "string",
            "null"
          ]
        },
        "authorized_checkpoints": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          },
          "uniqueItems": true
        },
        "execution_mode": {
          "enum": [
            "single-checkpoint",
            "multi-checkpoint"
          ],
          "default": "single-checkpoint"
        },
        "authority": {
          "type": "string",
          "minLength": 1
        }
      },
      "additionalProperties": false,
      "allOf": [
        {
          "if": {
            "properties": {
              "execution_mode": {
                "const": "multi-checkpoint"
              }
            },
            "required": [
              "execution_mode"
            ]
          },
          "then": {
            "required": [
              "authority"
            ],
            "properties": {
              "state": {
                "const": "granted"
              },
              "authorized_checkpoints": {
                "minItems": 1
              }
            }
          },
          "else": {
            "properties": {
              "authorized_checkpoints": {
                "maxItems": 1
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "state": {
                "enum": [
                  "not_granted",
                  "revoked"
                ]
              }
            }
          },
          "then": {
            "properties": {
              "authorized_checkpoints": {
                "maxItems": 0
              },
              "current_checkpoint": {
                "type": "null"
              }
            }
          }
        }
      ]
    },
    "backlog_ids": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      },
      "uniqueItems": true
    },
    "must_read": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      },
      "uniqueItems": true
    },
    "related_domain_rules": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      },
      "uniqueItems": true
    },
    "related_decisions": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      },
      "uniqueItems": true
    },
    "related_invariants": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      },
      "uniqueItems": true
    },
    "evals": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      },
      "uniqueItems": true
    },
    "source_scope": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      },
      "uniqueItems": true
    },
    "test_scope": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      },
      "uniqueItems": true
    },
    "docs_scope": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      },
      "uniqueItems": true
    },
    "must_not_change": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      },
      "uniqueItems": true
    },
    "gates": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      },
      "uniqueItems": true
    },
    "gate_profile": {
      "type": "string",
      "minLength": 1
    },
    "checkpoints": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "id",
          "goal",
          "depends_on",
          "gates",
          "evals",
          "status"
        ],
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^CP[0-9]+$"
          },
          "goal": {
            "type": "string",
            "minLength": 1
          },
          "depends_on": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1
            },
            "uniqueItems": true
          },
          "gates": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1
            },
            "uniqueItems": true
          },
          "evals": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1
            },
            "uniqueItems": true
          },
          "status": {
            "enum": [
              "not_started",
              "active",
              "blocked",
              "ready_for_review",
              "completed"
            ]
          }
        },
        "additionalProperties": false
      }
    },
    "git": {
      "type": "object",
      "required": [
        "branch",
        "pull_request",
        "suggested_branch",
        "one_pr_per_work_item",
        "merge_authorized"
      ],
      "properties": {
        "branch": {
          "type": [
            "string",
            "null"
          ]
        },
        "pull_request": {
          "type": [
            "integer",
            "null"
          ],
          "minimum": 1
        },
        "suggested_branch": {
          "type": [
            "string",
            "null"
          ]
        },
        "one_pr_per_work_item": {
          "const": true
        },
        "merge_authorized": {
          "const": false
        }
      },
      "additionalProperties": false
    }
  },
  "additionalProperties": false,
  "description": "Forma local apenas. Autorização, paths, links, IDs e lifecycle são checks relacionais adicionais. Templates com placeholders não são instâncias de execução."
}
